raphy":"globals/typography?id=primary","title_color":"globals/colors?id=primary"}},"elements":[],"isInner":false},{"id":"7656cf2","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Eight weeks of content across 14 teaching modules, with reflection exercises throughout. Around 30&#8211;45 minutes a week &#8212; or as fast as you like.</p>","align":"center","typography_font_size":{"unit":"px","size":17,"sizes":[]},"__globals__":{"typography_typography":"globals/typography?id=text","text_color":"globals/colors?id=text"}},"elements":[],"isInner":false},{"id":"9a422eb","elType":"widget","widgetType":"toggle","settings":{"tabs":[{"tab_title":"The Hidden Costs of Weak Boundaries","tab_content":"<p>Module 1: Signs You Might Be a Doormat</p><p>Module 2: When &#8220;Yes&#8221; Becomes Your Default</p>","_id":"d133187"},{"tab_title":"Building Stronger Fences &#8212; Understanding Boundaries","tab_content":"<p>Module 3: The Foundation of Boundaries</p><p>Module 4: Personal Boundaries: Your Line in the Sand</p>","_id":"c8df952"},{"tab_title":"Owning Your Yard &#8212; Protecting Your Space","tab_content":"<p>Module 5: Why Your Yard Matters More Than You Think</p><p>Module 6: When People Trample Your Boundaries</p>","_id":"47f2866"},{"tab_title":"The Art of Boundaries &#8212; Support vs. Sacrifice","tab_content":"<p>Module 7: Small Steps, Big Changes</p><p>Module 8: Keeping the Peace or Losing Yourself?</p>","_id":"028de71"},{"tab_title":"From People-Pleasing to Personal Power","tab_content":"<p>Module 9: Confessions of a People-Pleaser</p><p>Module 10: From &#8220;You Made Me Mad!&#8221; to Owning Your Reactions</p>","_id":"159b42b"},{"tab_title":"Property Lines &#8212; Where Do You Spend Your Time?","tab_content":"<p>Module 11: The Boomerang, the Noose, and the Hook</p><p>Module 12: Does Your Yard Look Like You Are Losing At Jumanji?</p>","_id":"4ea410f"},{"tab_title":"The Big Leagues: Holding Your Own","tab_content":"<p>Module 13: Setting Boundaries When You&#8217;ve Been Taught Self-Sacrifice</p><p>Module 14: Maneuvering Master Manipulators</p>","_id":"b9102f2"}],"title_typography_typography":"custom","title_typography_font_size":{"unit":"px","size":16,"sizes":[]},"__globals__":{"title_color":"globals/colors?id=primary","content_color":"globals/colors?id=text","title_typography_typography":"globals/typography?id=accent"}},"elements":[],"isInner":false}],"isInner":false}],"isInner":false},{"id":"80b9465","elType":"section","settings":{"background_background":"classic","background_color":"#FCEADF","padding":{"unit":"px","top":"70","right":"0","bottom":"70","left":"0","isLinked":false},"content_width":{"unit":"px","size":1140,"sizes":[]}},"elements":[{"id":"2f073ff","elType":"column","settings":{"_column_size":100,"_inline_size":null},"elements":[{"id":"22238da","elType":"widget","widgetType":"heading","settings":{"title":"What clients are saying","align":"center","typography_font_size":{"unit":"px","size":42,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":26,"sizes":[]},"__globals__":{"typography_typography":"globals/typography?id=primary","title_color":"globals/colors?id=primary"}},"elements":[],"isInner":false},{"id":"ceee209","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>&#8220;If I had learned to spot the boundary violations taught in the first module 15 years ago, I could have saved myself and my family years of heartache and pain.&#8221; <em>&#8212; Jonathan W.</em></p><p>&#8220;The course was truly life-changing. I always thought about boundaries in the context of dealing with others. I realized that I was violating boundaries within myself, in terms of unrealistic expectations.&#8221; <em>&#8212; Robert B.</em></p><p>&#8220;Dana explains concepts and presents the thought process necessary to recognize and manage boundaries.&#8221; <em>&#8212; Jade C.</em></p>","align":"center","typography_font_size":{"unit":"px","size":17,"sizes":[]},"__globals__":{"typography_typography":"globals/typography?id=text","text_color":"globals/colors?id=text"}},"elements":[],"isInner":false}],"isInner":false}],"isInner":false},{"id":"1578b5c","elType":"section","settings":{"background_background":"classic","background_color":"#FFFFFF","padding":{"unit":"px","top":"70","right":"0","bottom":"70","left":"0","isLinked":false},"content_width":{"unit":"px","size":1140,"sizes":[]}},"elements":[{"id":"66f850f","elType":"column","settings":{"_column_size":100,"_inline_size":null},"elements":[{"id":"aef7ac8","elType":"widget","widgetType":"heading","settings":{"title":"Questions","align":"center","typography_font_size":{"unit":"px","size":42,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":26,"sizes":[]},"__globals__":{"typography_typography":"globals/typography?id=primary","title_color":"globals/colors?id=primary"}},"elements":[],"isInner":false},{"id":"413e3b2","elType":"widget","widgetType":"toggle","settings":{"tabs":[{"tab_title":"How does the course work?","tab_content":"<p>Two teaching video modules to watch each week, plus exercises to complete. Around 30&#8211;45 minutes a week.</p>","_id":"6d66c7a"},{"tab_title":"How long is the course?","tab_content":"<p>It&#8217;s built as eight weeks across 14 teaching modules, but it&#8217;s self-paced &#8212; take it as fast or as slowly as you like.</p>","_id":"644fb12"},{"tab_title":"How long do I have access?","tab_content":"<p>Lifetime access. Come back to the material whenever you need a refresher.</p>","_id":"853ef86"},{"tab_title":"Is this therapy?","tab_content":"<p>No. This is coaching and education, not psychotherapy, and it isn&#8217;t a substitute for mental health treatment. Dana is a licensed psychotherapist and brings that training to how she teaches, but the course is educational.</p>","_id":"dcfaea2"},{"tab_title":"Can I get personal coaching alongside it?","tab_content":"<p>Yes. The coaching packages pair this course with private 90-minute calls &#8212; and the $99 you spend here is credit